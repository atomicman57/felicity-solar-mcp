{
  "name": "felicity-solar-data-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP for Felicity Solar plants, inverters, batteries, grid and history",
  "license": "MIT",
  "type": "module",
  "bin": {
    "felicity-solar-data-mcp": "src/server.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "cloud:build": "wrangler deploy --dry-run --outdir local/cloud-build",
    "pretest": "npm run cloud:build"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atomicman57/felicity-solar-mcp.git"
  },
  "homepage": "https://github.com/atomicman57/felicity-solar-mcp#readme",
  "bugs": {
    "url": "https://github.com/atomicman57/felicity-solar-mcp/issues"
  },
  "keywords": [
    "felicity-solar",
    "mcp",
    "solar",
    "inverter",
    "battery",
    "grid",
    "analytics"
  ],
  "devDependencies": {
    "miniflare": "^5.20261006.1-alpha",
    "wrangler": "^4.149.0"
  }
}
