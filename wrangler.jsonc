{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "felicity-solar",
  "main": "cloud/worker.mjs",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": {
    "directory": "cloud/public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "rules": [{ "type": "Text", "globs": ["**/*.pem"], "fallthrough": true }],
  "durable_objects": {
    "bindings": [{ "name": "SOLAR_STORE", "class_name": "SolarStore" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SolarStore"] }],
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" },
  ],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": false },
}
